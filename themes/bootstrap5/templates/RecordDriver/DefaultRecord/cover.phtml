<?php ob_start(); /* buffer image content */ ?>
  <?php
    $imgAttrs = [
      'class' => 'recordcover',
      'src' => $this->cover === false ? $this->url('cover-unavailable') : $this->cover,
      'alt' => $this->translate($this->cover === false ? 'No Cover Image' : 'Cover Image'),
    ];
    if ($linkPreview) {
      $imgAttrs['data-linkpreview'] = 'true';
    }
  ?>
  <?php if ($this->cover || $this->cover === false): ?>
    <img <?=$this->htmlAttributes($imgAttrs)?>>
  <?php else: ?>
    <?php
      // ajax covers
      $imgAttrs = array_merge($imgAttrs, [
        'alt' => $this->translate('Cover Image'),
        'class' => 'recordcover ajax',
        'data-context' => $this->context,
        'data-recordsource' => $driver->getSourceIdentifier(),
        'data-recordid' => $driver->getUniqueID(),
        'data-coversize' => $size,
      ]);
    ?>
    <div class="ajaxcover">
      <div class="spinner"><?=$this->icon('spinner') ?></div>
      <div class="cover-container">
        <img <?=$this->htmlAttributes($imgAttrs)?>>
      </div>
    </div>
  <?php endif; ?>
<?php $imageBuffer = ob_get_clean(); ?>

<?php
  // Determine link attributes; use legacy $this->link property as a fallback for backward compatibility.
  $linkAttributes = $this->linkAttributes ?? ($this->link ? ['href' => $this->link] : []);
  if ($linkAttributes && !isset($linkAttributes['class'])) {
    $linkAttributes['class'] = 'record-cover-link';
  }
?>
<?php if ($linkAttributes): ?>
  <a <?=$this->htmlAttributes($linkAttributes)?>><?=$imageBuffer ?></a>
<?php else: ?>
  <div aria-hidden="true"><?=$imageBuffer ?></div>
<?php endif; ?>
